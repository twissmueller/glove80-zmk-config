#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_de.h"

#define HYPER LC(LS(LG(LALT)))

// layers
#define DEFAULT 0
#define SYMBOL 1
#define NAVI 2
#define LOWER 3
#define MAGIC 4
#define FACTORY_TEST 5

/ {
    zmk,unicode-input-mode = "macos";

    behaviors {
        // For the "layer" key, it'd nice to be able to use it as either a shift or a toggle.
        // Configure it as a tap dance, so the first tap (or hold) is a &mo and the second tap is a &to
        layer_td: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "LAYER_TAP_DANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LOWER>, <&to LOWER>;
        };

        magic: magic_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_HOLD_TAP";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        // Homerow mods: https://zmk.dev/docs/keymaps/behaviors/hold-tap?examples=home_row_mods#example-use-cases
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <C T I E>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <N R S G>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro_0 {
            label = "RGB_UG_STATUS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&rgb_ug RGB_STATUS>;
        };

        bt_0: bt_profile_macro_0 {
            label = "BT_0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            label = "BT_1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            label = "BT_2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 2>;
        };

        bt_3: bt_profile_macro_3 {
            label = "BT_3";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>,
                  <&bt BT_SEL 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |  nop  | nop | nop |  nop |  nop |                                                               |  nop  |  nop  |  nop |  nop  | nop |
            // |  nop  |  1  |  2  |  3   |  4   |  5   |                                                 |  6   |   7   |   8   |  9   |   0   | nop |
            // |  nop  |  X  |  D  |  U   |  A   |  J   |                                                 |  P   |   H   |   L   |  M   |   Q   | nop |
            // |  nop  |  C  |  T  |  I   |  E   |  O   |                                                 |  B   |   N   |   R   |  S   |   G   | nop |
            // |  nop  |  F  |  V  |  Ü   |  Ä   |  Ö   | nop    | nop   | nop   | | nop   | nop    | nop |  Y   |   Z   |   W   |  ß   |   K   | nop |
            // | MAGIC | nop | nop | nop  | ESC  |      | SPACE  | TAB   | nop   | | nop   | BSPC   | RET |      |  DEL  |  nop  |  nop |  nop  | nop |

            bindings = < 
            &none           &none          &none         &none                &none                                                                                                                              &none          &none           &none         &none           &none
            &none           &none          &none         &none                &none           &none                                                                                                   &none      &none          &none           &none         &none           &none
            &none           &kp X          &kp D         &kp U                &kp A           &kp J                                                                                                   &kp P      &kp H          &kp L           &kp M         &kp Q           &kp DOT
            &none           &hml LCTRL C   &hml LALT T   &hml LSHIFT I        &hml LGUI E     &kp O                                                                                                   &kp B      &hmr RGUI N    &hmr RSHIFT R   &hmr RALT S   &hmr RCTRL G    &kp COMMA
            &none           &lt NAVI F     &kp V         &kp LEFT_BRACKET     &kp SQT         &kp SEMICOLON    &none              &none        &none       &none       &none       &none              &kp Z      &kp Y          &kp W           &kp MINUS     &lt NAVI K      &kp PG_UP
            &magic MAGIC 0  &none          &none         &none                &kp ESC                          &lt SYMBOL SPACE   &kp TAB      &none       &none       &kp BSPC    &lt SYMBOL RET                &kp DEL        &none           &none         &none           &none
            >;
        };

        symbol_and_numbers_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // https://zmk.dev/docs/keymaps/list-of-keycodes
            // | nop | nop | nop | nop | nop |                                                 | nop | nop | nop | nop | nop |
            // | nop | nop | nop | nop | nop | nop  |                                     | nop | nop | nop | nop | nop | nop |
            // | nop |  §  |  $  |  €  |  @  |  #   |                                     |  6  |  7  |  8  |  9  |  0  | nop |
            // | nop |  ?  |  !  |  ,  |  .  |  &   |                                     |  1  |  2  |  3  |  4  |  5  | nop |
            // | nop |  '  |  "  |  ;  |  :  |  %   | nop | nop | nop | | nop | nop | nop |  =  |  +  |  -  |  *  |  /  | nop |
            // | nop | nop | nop | nop | nop |      | nop | nop | nop | | nop | nop | nop |     | nop | nop | nop | nop | nop |
            
            bindings = <
            &none        &none             &none        &none               &none                                                                                                              &none        &none        &none             &none         &none
            &none        &none             &none        &none               &none         &none                                                                                   &none        &none        &none        &none             &none         &none
            &none        &none             &none        &kp LA(E)           &kp AT        &kp BSLH                                                                                &kp N6       &kp N7       &kp N8       &kp N9            &kp N0        &none
            &none        &kp LS(MINUS)     &kp EXCL     &kp COMMA           &kp DOT       &kp LS(N6)                                                                              &kp N1       &kp N2       &kp N3       &kp N4            &kp N5        &none
            &none        &kp APOS          &kp LS(N2)   &kp LS(COMMA)       &kp LS(DOT)   &kp LS(N5)   &none        &none        &none        &none        &none        &none     &kp LS(N0)   &kp RBKT     &kp FSLH     &kp KP_MULTIPLY   &kp KP_SLASH  &none
            &none        &none             &none        &none               &none                      &none        &none        &none        &none        &none        &none                  &none        &none        &none             &none         &none
            >;
        };

        navigation_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // | nop | nop  | nop   | nop   | nop    |                                                     | nop    | nop   | nop    | nop | nop |
            // | nop | nop  | nop   | nop   | nop    | nop   |                                     | nop   | nop    | nop   | nop    | nop | nop |
            // | nop | nop  | nop   | mup   | sup    | sup   |                                     | nop   | lclick | mup   | rclick | nop | nop |
            // | nop | HOME | mleft | nop   | mright | END   |                                     | nop   | mleft  | nop   | mright | nop | nop |
            // | nop | nop  | sleft | mdown | sright | sdown   | nop | nop | nop | | nop | nop | nop | nop   | nop    | mdown | nop    | nop | nop |
            // | nop | nop  | nop   | nop   | nop    |       | nop | nop | nop | | nop | nop | nop |       | nop    | nop   | nop    | nop | nop |
            
            bindings = <
            &none        &none        &none           &none      &none                                                                                                                        &none            &none            &none             &none           &none
            &none        &none        &none           &none      &none              &none                                                                                        &none        &none            &none            &none             &none           &none
            &none        &none        &none           &kp UP     &none              &msc SCRL_DOWN                                                                               &none        &mkp LCLK        &mmv MOVE_UP     &mkp RCLK         &none           &none
            &none        &kp HOME     &kp LEFT        &none      &kp RIGHT          &kp END                                                                                      &none        &mmv MOVE_LEFT   &kp RSHFT        &mmv MOVE_RIGHT   &none           &none
            &none        &none        &msc SCRL_LEFT  &kp DOWN   &msc SCRL_RIGHT    &msc SCRL_UP      &none        &none        &none        &none        &none        &none     &none        &none            &mmv MOVE_DOWN   &none             &none           &none
            &none        &none        &none           &none      &none                                &none        &none        &none        &none        &none        &none                  &none            &none            &none             &none           &none
            >;
        };


        lower_layer {
            bindings = <
            &kp C_BRI_DN      &kp C_BRI_UP        &kp C_PREV      &kp C_NEXT      &kp C_PP                                                                                                           &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP  &none           &kp PAUSE_BREAK
            &trans            &none               &none           &none           &none           &kp HOME                                                                              &kp LPAR     &kp KP_NUM   &kp KP_EQUAL &kp KP_DIVIDE &kp KP_MULTIPLY &kp PSCRN
            &trans            &none               &none           &kp UP          &none           &kp END                                                                               &kp RPAR     &kp KP_N7    &kp KP_N8    &kp KP_N9     &kp KP_MINUS    &kp SLCK
            &trans            &none               &kp LEFT        &kp DOWN        &kp RIGHT       &kp PG_UP                                                                             &kp PRCNT    &kp KP_N4    &kp KP_N5    &kp KP_N6     &kp KP_PLUS     &none
            &trans            &kp K_CMENU         &none           &kp F11         &kp F12         &kp PG_DN       &trans      &trans      &to DEFAULT &trans      &trans      &trans    &kp COMMA    &kp KP_N1    &kp KP_N2    &kp KP_N3     &kp KP_ENTER    &trans
            &trans            &kp CAPS            &kp INS         &kp F11         &kp F12                         &trans      &trans      &trans      &trans      &trans      &trans                 &kp KP_N0    &kp KP_N0    &kp KP_DOT    &kp KP_ENTER    &trans
            >;
        };

        magic_layer {
            bindings = <
            &bt BT_CLR        &none               &none           &none           &none                                                                                                             &none         &none        &none         &none           &bt BT_CLR_ALL
            &none             &none               &none           &none           &none           &none                                                                                 &none       &none         &none        &none         &none           &none
            &none             &rgb_ug RGB_SPI     &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG                                                                       &none       &none         &none        &none         &none           &none
            &bootloader       &rgb_ug RGB_SPD     &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF                                                                       &none       &none         &none        &none         &none           &bootloader
            &sys_reset        &none               &none           &none           &none           &none           &bt_2       &bt_3      &none        &none       &none      &none      &none       &none         &none        &none         &none           &sys_reset
            &none             &none               &none           &none           &none                           &bt_0       &bt_1      &out OUT_USB &none       &none      &none                  &none         &none        &none         &none           &to FACTORY_TEST
            >;
        };

        factory_test_layer {
            bindings = <
            &kp N0   &kp N6   &kp N2   &kp N8   &kp N4                                                                              &kp N4   &kp N8   &kp N2   &kp N6   &kp N0
            &kp N1   &kp N7   &kp N3   &kp N9   &kp N5   &kp N0                                                            &kp N0   &kp N5   &kp N9   &kp N3   &kp N7   &kp N1
            &kp N2   &kp N8   &kp N4   &kp N0   &kp N6   &kp N1                                                            &kp N1   &kp N6   &kp N0   &kp N4   &kp N8   &kp N2
            &kp N3   &kp N9   &kp N5   &kp N1   &kp N7   &kp N2                                                            &kp N2   &kp N7   &kp N1   &kp N5   &kp N9   &kp N3
            &kp N4   &kp N0   &kp N6   &kp N2   &kp N8   &kp N3   &kp N4   &kp N5   &kp N6      &kp N6   &kp N5   &kp N4   &kp N3   &kp N8   &kp N2   &kp N6   &kp N0   &kp N4
            &kp N5   &kp N1   &kp N7   &kp N3   &kp N9            &kp N7   &kp N8   &kp N9      &kp N9   &kp N8   &kp N7            &kp N9   &kp N3   &kp N7   &kp N1   &kp N5
            >;
        };

        none_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // | nop | nop | nop | nop | nop |                                                 | nop | nop | nop | nop | nop |
            // | nop | nop | nop | nop | nop | nop |                                     | nop | nop | nop | nop | nop | nop |
            // | nop | nop | nop | nop | nop | nop |                                     | nop | nop | nop | nop | nop | nop |
            // | nop | nop | nop | nop | nop | nop |                                     | nop | nop | nop | nop | nop | nop |
            // | nop | nop | nop | nop | nop | nop | nop | nop | nop | | nop | nop | nop | nop | nop | nop | nop | nop | nop |
            // | nop | nop | nop | nop | nop |     | nop | nop | nop | | nop | nop | nop |     | nop | nop | nop | nop | nop |
            
            bindings = <
            &none        &none        &none        &none        &none                                                                                                                &none        &none        &none        &none        &none
            &none        &none        &none        &none        &none        &none                                                                                      &none        &none        &none        &none        &none        &none
            &none        &none        &none        &none        &none        &none                                                                                      &none        &none        &none        &none        &none        &none
            &none        &none        &none        &none        &none        &none                                                                                      &none        &none        &none        &none        &none        &none
            &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none        &none
            &none        &none        &none        &none        &none                     &none        &none        &none        &none        &none        &none                     &none        &none        &none        &none        &none
            >;
        };
    };
};
